    "highContrast": {
      "$description": "Mode contraste élevé de Windows : couleurs système (GetSysColor / SystemPalette). Aucune transparence, aucune ombre, bordures 2 px.",
      "bgWindow": "Window", "windowTint": "Window", "surfaceCard": "Window", "surfaceCardHover": "Window",
      "surfaceCardSelected": "Window", "surfaceRaised": "Window", "surfaceSheet": "Window", "surfaceSheetOpaque": "Window",
      "surfaceTooltip": "Window", "thumbPlaceholder": "Window",
      "borderHairline": "WindowText", "borderCard": "WindowText", "borderControl": "ButtonText", "borderStrong": "WindowText",
      "fillControl": "ButtonFace", "fillControlHover": "ButtonFace", "fillControlPressed": "ButtonFace",
      "segmentThumb": "Highlight", "segmentSelectedText": "HighlightText", "scrim": "transparent",
      "textPrimary": "WindowText", "textSecondary": "WindowText", "textTertiary": "WindowText", "textDisabled": "GrayText",
      "textOnAccent": "HighlightText", "accent": "Highlight", "accentHover": "Highlight", "accentPressed": "Highlight",
      "accentText": "HotLight", "accentTint": "transparent", "progress": "Highlight", "focusRing": "Highlight",
      "success": "WindowText", "successTint": "transparent", "onSuccess": "Window",
      "warning": "WindowText", "warningTint": "transparent", "danger": "WindowText", "dangerTint": "transparent",
      "skeleton": "GrayText", "skeletonShine": "GrayText",
      "shadow1": "transparent", "shadow2": "transparent", "shadow3": "transparent",
      "glassTint": "Window", "glassRim": "WindowText", "glassRimLow": "WindowText", "glassSpecular": "transparent", "glassShadow": "transparent"
    }
  },

  "typography": {
    "family": {
      "display": ["Segoe UI Variable Display", "Segoe UI Variable", "Segoe UI"],
      "text":    ["Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI"],
      "small":   ["Segoe UI Variable Small", "Segoe UI Variable", "Segoe UI"],
      "mono":    ["Cascadia Mono", "Consolas"]
    },
    "weight": { "regular": 400, "semibold": 600 },
    "style": {
      "display":       { "family": "display", "size": 28, "lineHeight": 34, "weight": 600, "letterSpacing": -0.2 },
      "title1":        { "family": "display", "size": 22, "lineHeight": 28, "weight": 600, "letterSpacing": 0 },
      "title2":        { "family": "text",    "size": 17, "lineHeight": 22, "weight": 600, "letterSpacing": 0 },
      "headline":      { "family": "text",    "size": 14, "lineHeight": 20, "weight": 600, "letterSpacing": 0 },
      "body":          { "family": "text",    "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": 0 },
      "callout":       { "family": "text",    "size": 13, "lineHeight": 18, "weight": 400, "letterSpacing": 0 },
      "caption":       { "family": "small",   "size": 12, "lineHeight": 16, "weight": 400, "letterSpacing": 0 },
      "captionStrong": { "family": "small",   "size": 12, "lineHeight": 16, "weight": 600, "letterSpacing": 0 },
      "badge":         { "family": "small",   "size": 11, "lineHeight": 14, "weight": 600, "letterSpacing": 0.2 },
      "mono":          { "family": "mono",    "size": 12, "lineHeight": 18, "weight": 400, "letterSpacing": 0 }
    },
    "numerals": "tabular (OpenType tnum) pour %, i/s, durées, tailles"
  },

  "space": { "s0_5": 2, "s1": 4, "s2": 8, "s3": 12, "s4": 16, "s5": 20, "s6": 24, "s8": 32, "s10": 40, "s12": 48, "s16": 64 },

  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "full": 999 },

  "size": {
    "controlSm": 28, "control": 32, "controlLg": 36, "hitMin": 32,
    "iconSm": 16, "icon": 20, "iconLg": 24, "iconStroke": 1.75,
    "toolbarH": 52, "statusBarH": 32, "titleBarH": 32,
    "cardMinH": 80, "thumbW": 96, "thumbH": 54, "thumbActiveW": 128, "thumbActiveH": 72, "thumbNarrowW": 56, "thumbNarrowH": 32,
    "progressH": 4, "progressHActive": 6, "badgeH": 20, "statusDot": 8, "checkBadge": 20,
    "focusRingW": 2, "focusRingOffset": 2, "border": 1, "dropZoneBorder": 1.5,
    "windowMinW": 760, "windowMinH": 520, "windowDefaultW": 1100, "windowDefaultH": 720,
    "contentMaxW": 880, "sheetW": 520, "sheetTop": 64, "toastMaxW": 480, "primaryButtonMinW": 148,
    "breakpointNarrow": 900, "breakpointShort": 600,
    "glassButtonH": 44, "glassButtonPadX": 24,
    "$glassButton": "Bouton de verre autonome (capsule) : 44 px de haut, 24 px de marge latérale, libellé headline. Biseau effectif = min(niveau.bezel, (hauteur - interligne) / 2) = 12 px (aucun texte dans le biseau). Introduit par ENH-004 (capsule de démonstration), réutilisé par les futures actions de verre."
  },

  "elevation": {
    "e0": { "y": 0,  "blur": 0,  "color": "none" },
    "e1": { "y": 1,  "blur": 2,  "color": "shadow1", "usage": "cartes au repos (avec borderCard)" },
    "e2": { "y": 4,  "blur": 12, "color": "shadow2", "usage": "carte survolée ou en cours, toast, info-bulle, menu" },
    "e3": { "y": 16, "blur": 40, "color": "shadow3", "usage": "feuille, carte soulevée pendant un glisser" }
  },

  "material": {
    "windowMica":  { "backdrop": "Mica (DWMSBT_MAINWINDOW)", "tint": "windowTint", "fallback": "bgWindow" },
    "rule": "Fond de fenêtre = Mica (système). Tout ce qui flotte au-dessus du contenu = verre (voir 'glass'). Sur verre : jamais de textTertiary ; texte uniquement hors du biseau."
  },

  "glass": {
    "$description": "Verre « liquide » d'Enhance, inspiré du langage Liquid Glass d'Apple (principes seulement, aucun asset). Le verre échantillonne le contenu situé dessous, le réfracte près des bords (lentille), le floute, le teinte de façon adaptative et porte un reflet spéculaire et un liseré lumineux.",
    "levels": {
      "regular": { "usage": "barre Préréglage flottante, groupe de boutons de la barre d'outils, toast, menu, info-bulle", "blur": 24, "saturation": 1.35, "refraction": 12, "bezel": 14, "specular": 0.35, "tintScale": 1.0, "textAllowed": true },
      "clear":   { "usage": "au-dessus d'images (pastille de dépôt sur la liste, futur comparateur avant/après) ; libellé court uniquement", "blur": 8, "saturation": 1.2, "refraction": 16, "bezel": 16, "specular": 0.45, "tintScale": 0.55, "textAllowed": "libellé court, avec voile local garantissant 4,5:1" },
      "thick":   { "usage": "feuilles (Réglages, Détails de l'erreur…)", "blur": 40, "saturation": 1.2, "refraction": 8, "bezel": 18, "specular": 0.25, "tintScale": 1.0, "textAllowed": true }
    },
    "adaptiveTint": {
      "$description": "Opacité de la teinte calculée par pixel à partir de la luminance relative Lb du fond flouté sous le verre : alpha = mix(alphaA, alphaB, smoothstep(lumaA, lumaB, Lb)). Garantit textSecondary >= 4,5:1 quel que soit le fond (vérifié dans le catalogue).",
      "dark":  { "tint": "glassTint", "alphaA": 0.62, "alphaB": 0.88, "lumaA": 0.05, "lumaB": 0.50, "sens": "plus le fond est clair, plus la teinte est opaque" },
      "light": { "tint": "glassTint", "alphaA": 0.90, "alphaB": 0.62, "lumaA": 0.10, "lumaB": 0.60, "sens": "plus le fond est sombre, plus la teinte est opaque" },
      "mockupFixedAlpha": { "dark": 0.80, "light": 0.80, "note": "Les maquettes HTML ne peuvent pas mesurer le fond : teinte fixe." }
    },
    "radius": { "bar": 22, "capsule": 999, "sheet": 20, "toast": 18 },
    "fusion": { "smoothK": 16, "maxShapes": 4, "note": "Union lisse (smooth-min) des formes d'un même groupe de verre : les capsules se rapprochent, fusionnent, se séparent." },
    "light": { "angleDeg": -50, "followPointer": true, "pointerLerp": "fast/decelerate", "note": "Aucune animation au repos : la lumière ne bouge que quand le pointeur survole le verre ou que la liste défile." },
    "press": { "scale": 1.03, "specularBoost": 1.6 },
    "quality": {
      "full":   "réfraction + flou + teinte adaptative + reflet + liseré + fusion",
      "lite":   "flou (mipmaps) + teinte adaptative + liseré statique ; ni réfraction ni reflet mobile",
      "opaque": "surfaceRaised opaque + contour borderControl ; aucun échantillonnage du fond",
      "policy": "full au repos ; pendant un traitement : full tant que le rendu de l'interface reste < budget, sinon lite (> 4 ms GPU sur 30 images), sinon opaque (> 8 ms). Transparence Windows désactivée ou contraste élevé : opaque. Mouvement réduit : pas de fusion animée ni de reflet qui suit le pointeur."
    },
    "budget": { "uiGpuMsTarget": 1.0, "uiGpuMsMax": 2.0, "backdropScale": 0.5, "backdropMaxHzDuringProcessing": 10, "continuousRenderingAtRest": false }
  },

  "motion": {
    "duration": {
      "press": 100, "fast": 150, "base": 200, "medium": 250, "slow": 300, "slower": 350,
      "stagger": 30, "themeFade": 300, "highlightFlash": 400, "tooltipDelay": 600,
      "shimmer": 1400, "indeterminate": 1600, "toast": 5000, "refusedMessage": 6000,
      "windowAppear": 200, "themeSwap": 250,
      "$windowAppearThemeSwap": "Fondu d'ouverture de la fenêtre et fondu de changement de thème : exceptions à la règle « les fondus restent » ; 0 ms en mouvement réduit (ENH-004). themeSwap = 250 ms pour tenir « bascule < 300 ms » malgré la capture grabToImage (1 à 2 images). themeFade (300) n'est plus utilisé que par les maquettes antérieures."
    },
    "easing": {
      "standard":   [0.4, 0.0, 0.2, 1.0],
      "decelerate": [0.0, 0.0, 0.2, 1.0],
      "accelerate": [0.4, 0.0, 1.0, 1.0],
      "emphasized": [0.32, 0.72, 0.0, 1.0],
      "spring":     [0.34, 1.30, 0.64, 1.0],
      "linear":     [0.0, 0.0, 1.0, 1.0]
    },
    "spring": {
      "$description": "Ressorts physiques. Les transitions décrites par une durée utilisent la courbe 'spring' (équivalente). SpringAnimation QML seulement pour le relâchement d'un glisser.",
      "gentle": { "stiffness": 300, "damping": 30, "mass": 1, "dampingRatio": 0.87, "bezierEquivalent": "emphasized", "duration": 300 },
      "snappy": { "stiffness": 400, "damping": 28, "mass": 1, "dampingRatio": 0.70, "bezierEquivalent": "spring",     "duration": 250 },
      "qmlDragRelease": { "spring": 4.0, "damping": 0.40, "mass": 1.0, "epsilon": 0.25 }
    },
    "reducedMotion": "Mouvements spatiaux (x, y, échelle, hauteur) : 0 ms. Fondus d'opacité et de couleur : conservés, sauf windowAppear et themeSwap (0 ms). Boucles (squelette, barre indéterminée) : statiques. Verre : ni ressort de pression, ni reflet qui suit le pointeur.",
    "transition": {
      "hover":            { "duration": "fast",    "easing": "standard",   "props": "couleur de fond, opacité des actions" },
      "pressIn":          { "duration": "press",   "easing": "standard",   "props": "échelle 0.97" },
      "pressOut":         { "duration": "base",    "easing": "spring",     "props": "échelle 1" },
      "focusRing":        { "duration": "fast",    "easing": "decelerate", "props": "opacité, décalage 4 → 2 px" },
      "segmentThumb":     { "duration": "medium",  "easing": "emphasized", "props": "x" },
      "switchKnob":       { "duration": "base",    "easing": "spring",     "props": "x" },
      "dropHoverIn":      { "duration": "base",    "easing": "decelerate", "props": "bordure, fond, illustration échelle 1.02" },
      "dropHoverOut":     { "duration": "fast",    "easing": "accelerate" },
      "cardEnter":        { "duration": "medium",  "easing": "spring",     "delayPerItem": "stagger", "props": "y +12 → 0, opacité, échelle 0.98 → 1" },
      "cardExit":         { "duration": "base",    "easing": "accelerate", "props": "opacité, échelle 0.98, puis hauteur (medium, standard)" },
      "cardDisplaced":    { "duration": "medium",  "easing": "spring",     "props": "y" },
      "cardExpand":       { "duration": "slow",    "easing": "emphasized", "props": "hauteur, taille de la vignette" },
      "cardComplete":     { "duration": "slow",    "easing": "spring",     "props": "coche échelle 0.6 → 1 + tracé" },
      "progressValue":    { "duration": "base",    "easing": "standard",   "props": "largeur de la barre" },
      "numberChange":     { "duration": "fast",    "easing": "standard",   "props": "fondu + y 4 px" },
      "bannerIn":         { "duration": "medium",  "easing": "decelerate", "props": "hauteur, opacité, y -4 → 0" },
      "toastIn":          { "duration": "medium",  "easing": "decelerate", "props": "y +8 → 0, opacité" },
      "toastOut":         { "duration": "base",    "easing": "accelerate" },
      "sheetIn":          { "duration": "slower",  "easing": "emphasized", "props": "opacité, y -12 → 0, échelle 0.98 → 1 ; voile (medium, standard)" },
      "sheetOut":         { "duration": "medium",  "easing": "accelerate" },
      "panelIn":          { "duration": "slow",    "easing": "emphasized", "props": "y +16 → 0, opacité, hauteur" },
      "primaryBump":      { "up": "press", "down": "base", "easingUp": "decelerate", "easingDown": "spring", "props": "échelle 1 → 1.04 → 1" },
      "themeChange":      { "duration": "themeSwap", "easing": "standard", "props": "fondu d'une capture de la fenêtre (0 ms en mouvement réduit)" },
      "windowAppear":     { "duration": "windowAppear", "easing": "decelerate", "props": "opacité de la fenêtre à l'ouverture : animation d'ouverture DWM, première image déjà complète (0 ms en mouvement réduit)" },
      "duplicateFlash":   { "duration": "highlightFlash", "easing": "standard", "props": "fond accentTint aller-retour" },
      "tooltip":          { "delay": "tooltipDelay", "duration": "fast", "easing": "standard" },
      "glassMorph":       { "duration": "slower",  "easing": "spring",     "props": "géométrie des formes de verre (taille, rayon, position) et facteur de fusion ; mouvement réduit : fondu enchaîné (fast)" },
      "glassPressIn":     { "duration": "press",   "easing": "decelerate", "props": "échelle 1 → 1.03, reflet ×1.6" },
      "glassPressOut":    { "duration": "medium",  "easing": "spring",     "props": "retour" },
      "specularFollow":   { "duration": "fast",    "easing": "decelerate", "props": "direction de la lumière vers le pointeur" },
      "segmentLiquid":    { "duration": "medium",  "easing": "emphasized", "props": "pastille étirée ×1.12 à mi-course pendant le déplacement" }
    }
  },

  "icon": {
    "set": "Lucide",
    "license": "ISC (certaines icônes dérivées de Feather, MIT)",
    "source": "https://lucide.dev — dépôt lucide-icons/lucide",
    "grid": 24, "stroke": 1.75, "linecap": "round", "linejoin": "round",
    "status": "À valider par secdevops avant import. Les maquettes utilisent des tracés provisoires dessinés à la main dans le même style."
  }
}
