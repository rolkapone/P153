{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "enhance",
  "version": "0.1.0",
  "builtin-baseline": "a2f9862da6d88040a8537fb9b8cb24deaa9a196b",
  "dependencies": [
    "gtest",
    "nlohmann-json",
    { "name": "spdlog", "default-features": false },
    "tl-expected"
  ],
  "features": {
    "ui": {
      "description": "Interface Qt 6 / Qt Quick, sans Qt6Network (ADR-024)",
      "dependencies": [
        { "name": "qtbase", "default-features": false, "features": ["gui", "harfbuzz", "freetype", "png", "jpeg"] },
        { "name": "qtdeclarative", "default-features": false },
        "qtsvg",
        "qtshadertools",
        "qttools"
      ]
    },
    "ffmpeg": {
      "description": "FFmpeg LGPL (bascule avant release, ADR-025)",
      "dependencies": [
        { "name": "ffmpeg", "default-features": false, "features": ["avcodec", "avformat", "swscale", "swresample", "nvcodec"] }
      ]
    }
  }
}
